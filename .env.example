# Copy this file to .env and fill in on deployment day (.env is not committed).

# Web3Forms access key (from the Web3Forms dashboard). Required for the contact form to send.
VITE_WEB3FORMS_KEY=

# Set to true ONLY if the Web3Forms account is on the Pro plan (file attachments are a paid feature).
# Leave empty and the file upload box is hidden on the live site.
VITE_WEB3FORMS_UPLOADS=

# Optional: where the Work page loads portfolio photos from. Leave empty to use /api/portfolio
# on the same site (the Cloudflare Pages Function in functions/api/portfolio.js).
VITE_PORTFOLIO_API=
