# Production values live in .env.production (committed: both keys below are public by design).
# Copy this file to .env for local overrides (.env is not committed).

# Web3Forms access key: the contact form sends through it to the inbox the key was made for.
VITE_WEB3FORMS_KEY=

# Cloudflare Turnstile site key: turns on contact-form file uploads (files go to R2 via /api/quote-files).
# The matching secret is the TURNSTILE_SECRET secret on the Pages project, never in a file.
VITE_TURNSTILE_SITE_KEY=

# Optional: where the Work page loads portfolio photos from. Leave empty to use /api/portfolio
# on the same site (the Cloudflare Pages Function in functions/api/portfolio.js).
VITE_PORTFOLIO_API=
