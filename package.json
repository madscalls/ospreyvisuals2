{
  "name": "osprey-visuals",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --mode admindemo --port 5180 --strictPort --open /ospreyvisuals2/admin",
