    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "simple-icons": "^16.36.0",
    "vite": "^8.3.5"
  }
